# ---------------------------------------------------------------------------
# LeadSense environment configuration
# Copy to .env and adjust. Every value below has a safe default for local demo.
# ---------------------------------------------------------------------------

APP_NAME=LeadSense
ENVIRONMENT=local
DEBUG=true
API_PREFIX=/api/v1

# --- Database -------------------------------------------------------------
# Postgres (recommended, needed for pgvector):
# DATABASE_URL=postgresql+psycopg://leadsense:leadsense@localhost:5432/leadsense
# SQLite fallback so the API runs with zero infrastructure:
DATABASE_URL=sqlite:///./leadsense.db
ENABLE_PGVECTOR=false

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# When true, background tasks run inline in the request (no worker needed).
CELERY_TASK_ALWAYS_EAGER=true

# --- Identity (Microsoft Entra ID) ---------------------------------------
# Leave AUTH_MODE=dev to use locally-signed tokens from /auth/dev-token.
# Set AUTH_MODE=entra and fill the values below for real SSO.
AUTH_MODE=dev
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=

# --- LLM gateway ----------------------------------------------------------
# Providers: echo | anthropic | openai | azure_openai
LLM_PROVIDER=echo
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
EMBEDDING_MODEL=text-embedding-3-small

# --- Email delivery (AWS SES) --------------------------------------------
# EMAIL_PROVIDER: console | ses
EMAIL_PROVIDER=console
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_ADDRESS=no-reply@example.com
SES_CONFIGURATION_SET=

# --- Object storage -------------------------------------------------------
# STORAGE_BACKEND: local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./uploads
S3_BUCKET=

# --- Source connectors ----------------------------------------------------
# DEMO_CONNECTORS=true makes every connector return synthetic records when no
# credentials are configured, so the whole pipeline runs offline.
DEMO_CONNECTORS=true

SALESFORCE_DOMAIN=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_API_VERSION=v60.0

HUBSPOT_ACCESS_TOKEN=

APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io/v1

ZOOMINFO_USERNAME=
ZOOMINFO_PASSWORD=

# --- Observability --------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
